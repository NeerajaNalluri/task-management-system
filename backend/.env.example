# Copy this file to ".env" and fill in your own values.

# PostgreSQL connection (same details you use in DBeaver)
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=task_management

# Secret used to sign tokens. Change this to a long random string.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Token lifetimes
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Print every SQL query in the terminal (1 = on, 0 = off)
SQL_ECHO=0
